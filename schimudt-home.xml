<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schimudt Home launcher for Grandstream GRP2601/02/03/04.

  PBX extension map:
      0  Home IVR
    200  Ring all
    101  Tan
    102  Fang
    555  HugHug

  schimudt-21x14.png is embedded below as a 21x14, 1-bit BMP encoded as base64.

  $T follows the phone's Time Display Format setting. Set the handset to
  System Settings > Time and Language > Time Display Format > 24-hour.
-->
<Screens>
  <Screen model="GRP2603;GRP2604" width="132" height="64">
    <!-- Page 1: quiet everyday clock. -->
    <IdleScreen>
      <ShowStatusLine width="70">true</ShowStatusLine>
      <DisplayElement>
        <DisplayString halign="right" width="40" height="14" font="time_14">
          <DisplayStr>$T</DisplayStr>
          <X>92</X>
          <Y>1</Y>
        </DisplayString>
        <DisplayString halign="right" width="62" height="11">
          <DisplayStr>$f</DisplayStr>
          <X>70</X>
          <Y>16</Y>
        </DisplayString>
      </DisplayElement>
      <DisplayBitmap isfile="false" isflash="false">
        <Bitmap>Qk26AAAAAAAAAIIAAABsAAAAFQAAAA4AAAABAAEAAAAAADgAAAAAAAAAAAAAAAIAAAACAAAAAAD/AAD/AAD/AAAAAAAA/0JHUnMAAAAAAAAAAAAAAEAAAAAAAAAAAAAAAEAAAAAAAAAAAAAAAEAAAAAAAAAAAAAAAAAAAAAA////AAAAAAA//+AAH//AAAffAAABBAAAAAAAAAAAAAAAAAAAAAAAAAEEAAAH3wAAH//AAD//4AAAAAAA</Bitmap>
        <X>70</X>
        <Y>1</Y>
      </DisplayBitmap>
      <SoftKeys>
        <SoftKey>
          <Action><RemotePhonebook1 /></Action>
          <Label>Phone</Label>
        </SoftKey>
        <SoftKey>
          <Action><RemotePhonebook2 /></Action>
          <Label>Pple</Label>
        </SoftKey>
        <SoftKey>
          <Action><SwitchSCR /></Action>
          <Label>&#160;</Label>
          <displayCondition><conditionType>SubScreen</conditionType></displayCondition>
        </SoftKey>
        <SoftKey>
          <Action><Dial><Account>0</Account><Number>0</Number></Dial></Action>
          <Label>Menu</Label>
        </SoftKey>
      </SoftKeys>
    </IdleScreen>

    <!-- Page 2: playful IVR launch pad. -->
    <IdleScreen>
      <ShowStatusLine width="70">true</ShowStatusLine>
      <DisplayElement>
        <DisplayString halign="right" width="40" height="14" font="time_14">
          <DisplayStr>$T</DisplayStr>
          <X>92</X>
          <Y>1</Y>
        </DisplayString>
        <DisplayString halign="right" width="62" height="11">
          <DisplayStr>$f</DisplayStr>
          <X>70</X>
          <Y>16</Y>
        </DisplayString>
      </DisplayElement>
      <DisplayBitmap isfile="false" isflash="false">
